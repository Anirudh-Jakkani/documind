# Copy this file to .env and fill in your own key. Never put a real key in this file:
# .env.example is committed to git, .env is not.

# LLM: any OpenAI-compatible API.
# Groq (free tier):  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
# OpenRouter:        LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<provider/model>
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional overrides (defaults are in documind/config.py)
# LLM_REASONING_EFFORT=low
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# CHUNK_STRATEGY=section
# RETRIEVAL_MODE=hybrid
