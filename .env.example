# Copy this file to .env and add your own keys. Never put a real key in this file:
# .env.example is committed to git, .env is not.

# One key per provider. All three have free tiers without a card.
GEMINI_API_KEY=      # aistudio.google.com -> Get API key
GROQ_API_KEY=        # console.groq.com -> API Keys
# OPENROUTER_API_KEY=

# The model that writes answers (defaults shown; see documind/config.py)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=

# The model that grades answers in the evaluation (a different model family)
# JUDGE_PROVIDER=groq
# JUDGE_MODEL=qwen/qwen3.8-27b

# Retrieval
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_STRATEGY=section
# RETRIEVAL_MODE=hybrid
